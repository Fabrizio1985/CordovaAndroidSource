<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>it.fabrizio</groupId>
	<artifactId>cordova-android-source</artifactId>
	<version>14.0.0</version>

	<repositories>
		<repository>
			<id>google</id>
			<url>https://maven.google.com/</url>
		</repository>
	</repositories>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

		<!-- Versioni dipendenze -->
		<maven.compiler.source>1.17</maven.compiler.source>
		<maven.compiler.target>1.17</maven.compiler.target>
		
		<path.android.source>E:\Programmazione\android-sdk\platforms\android-33\android-without-java.jar</path.android.source>
	</properties>

	<dependencies>
		<dependency>
			<groupId>com.google.android</groupId>
			<artifactId>android</artifactId>
			<version>33.0.0</version>
			<scope>system</scope>
			<systemPath>${path.android.source}</systemPath>
		</dependency>

		<dependency>
			<groupId>org.json</groupId>
			<artifactId>json</artifactId>
			<version>20180813</version>
		</dependency>
		
		<dependency>
			<groupId>org.apache.cordova</groupId>
			<artifactId>framework</artifactId>
			<version>14.0.1</version>
			<scope>compile</scope>
			<type>aar</type>
			<exclusions>
				<exclusion>
					<groupId>androidx.appcompat</groupId>
					<artifactId>appcompat</artifactId>
				</exclusion>
				<exclusion>
					<groupId>androidx.webkit</groupId>
					<artifactId>webkit</artifactId>
				</exclusion>
				<exclusion>
					<groupId>androidx.core</groupId>
					<artifactId>core-splashscreen</artifactId>
				</exclusion>
				<exclusion>
					<groupId>androidx.lifecycle</groupId>
					<artifactId>lifecycle-common</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		
		<dependency>
			<groupId>androidx.appcompat</groupId>
			<artifactId>appcompat</artifactId>
			<version>1.7.0</version>
			<scope>compile</scope>
			<type>aar</type>
		</dependency>
		
		<dependency>
			<groupId>androidx.webkit</groupId>
			<artifactId>webkit</artifactId>
			<version>1.12.1</version>
			<scope>compile</scope>
			<type>aar</type>
		</dependency>
		
		<dependency>
			<groupId>androidx.core</groupId>
			<artifactId>core-splashscreen</artifactId>
			<version>1.0.1</version>
			<scope>compile</scope>
			<type>aar</type>
		</dependency>
		
		<dependency>
			<groupId>androidx.biometric</groupId>
			<artifactId>biometric</artifactId>
			<version>1.1.0</version>
			<scope>compile</scope>
			<type>aar</type>
		</dependency>
		
		<dependency>
			<groupId>androidx.credentials</groupId>
			<artifactId>credentials</artifactId>
			<version>1.3.0</version>
			<scope>compile</scope>
			<type>aar</type>
		</dependency>
		
		<dependency>
			<groupId>androidx.credentials</groupId>
			<artifactId>credentials-play-services-auth</artifactId>
			<version>1.3.0</version>
			<scope>compile</scope>
			<type>aar</type>
			<exclusions>
				<exclusion>
					<groupId>com.google.android.gms</groupId>
					<artifactId>play-services-fido</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.android.gms</groupId>
					<artifactId>play-services-auth</artifactId>
				</exclusion>
				<exclusion>
					<groupId>com.google.android.libraries.identity.googleid</groupId>
					<artifactId>googleid</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>2.4.3</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<filters>
								<filter>
									<artifact>android</artifact>
									<excludes>
										<exclude>**/*.class</exclude>
									</excludes>
								</filter>
							</filters>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>


	<!-- BLOCCO QUESTA LIBRERIA A QUESTA VERSIONE -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>androidx.lifecycle</groupId>
				<artifactId>lifecycle-common</artifactId>
				<version>2.6.1</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
